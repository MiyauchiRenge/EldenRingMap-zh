# ---------------------------------------------------------------------------
# Anything derived from the game itself stays local.
#
# Extracting these from a copy you own is fine; publishing them is
# redistributing FromSoftware/Bandai Namco assets. Setup.bat regenerates all of
# it in a couple of minutes, so a clone loses nothing.
# ---------------------------------------------------------------------------

# Map tile pyramids + stitched masters (~63 MB, 7k files)
web/tiles/
# The game's own map icon sprites, extracted by tools/extract_icons.py
web/icons/*
# ...except the Map-for-Goblins category icons (MIT-licensed, not game assets)
!web/icons/categories/
cache/

# Generated from regulation.bin and the game's message files
data/markers.json
data/legacy-conv.json

# Your own progress and anything read out of your save
data/user-state.json
data/timeline.jsonl

# ---------------------------------------------------------------------------
# Safe to commit: data/eventflag_bst.txt (ER-Save-Lib) and data/paramdefs/*.xml
# (Paramdex) are community-maintained format documentation, not game assets.
# ---------------------------------------------------------------------------

node_modules/
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Raw research notes - superseded by docs/HOW-IT-WORKS.md and known to
# contain some incorrect early conclusions. Kept locally, not published.
docs/RESEARCH-BRIEF.md

# Generated by tools/extract_items.py, extract_pieces.py and enumerate_maps.py
data/items.json
data/pieces.json
data/npcs.json
cache/map-list.txt

# Fetched by tools/fetch_tips.py. Everything else under data/ comes out of your
# own copy of the game; this is a third party's writing, kept locally for your
# own use. It must not be committed or published - see the tool's header.
data/tips.json
cache/tips/

# The hidden launcher writes its console output here.
logs/

# Everything under data/ is produced by our scripts from the user's own game files, so
# none of it is published. Two exceptions are ours to publish: the format documentation
# and the small hand-checked boss-drop attributions.
data/*.json
data/*.jsonl
!data/boss-drop-overrides.json
!data/enemy-names.json

# Nothing under data/ is published: the generated marker files come from the user's game,
# and even the small hand-checked tables carry item and boss names. The only exception is
# the format documentation, which is our own writing.
data/**
!data/README.md

# Scratch commit messages are never part of the repo.
_squash-msg.txt
_commit-msg-*.txt
